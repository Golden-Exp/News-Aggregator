    {
      "id": "text-fetch-detail",
      "type": "text",
      "x": 115,
      "y": 222,
      "width": 660,
      "height": 40,
      "text": "• Conditional GET (If-None-Match / If-Modified-Since)   • 304 → skip, update next_due_at only\n• Exponential backoff on errors   • Adaptive interval: fewer new items → slow down, more → speed up",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "fillStyle": "solid",
      "strokeColor": "#534AB7",
      "backgroundColor": "transparent",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "version": 5,
      "versionNonce": 2041523106,
      "index": "aD",
      "isDeleted": false,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1780854238677,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "• Conditional GET (If-None-Match / If-Modified-Since)   • 304 → skip, update next_due_at only\n• Exponential backoff on errors   • Adaptive interval: fewer new items → slow down, more → speed up",
      "autoResize": true,
      "lineHeight": 1.6666666666666667
    },
